# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://localhost:27017/lifeos
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lifeos?retryWrites=true&w=majority
# If USE_MEMORY_DB=true is set, an in-memory MongoDB will be used automatically (ideal for quick testing/demos)
MONGODB_URI=mongodb://localhost:27017/lifeos
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=super_secret_jwt_key_lifeos_dev_2026_change_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Future Integration Placeholders (Phase 2 & beyond)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
# TOKEN_ENCRYPTION_KEY=32-character-random-key-here
